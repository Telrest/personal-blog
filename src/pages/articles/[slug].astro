---
import ArticlePage from '../../features/articles/ui/ArticlePage.astro';
import { getPublishedPosts } from '../../features/articles/data/posts';

export async function getStaticPaths() {
  return (await getPublishedPosts()).map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---

<ArticlePage post={post} />
