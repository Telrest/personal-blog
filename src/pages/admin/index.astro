---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="写作空间 · Telrest">
  <main id="main" class="admin-page"><div class="admin-card"><span class="intro-icon"><Icon name="pen" size={30} /></span><p class="eyebrow">THE WRITING ROOM</p><h1>写作空间，<br />正在搭建。</h1><p>这里将成为我记录想法、整理文章的地方。<br />登录与发布功能尚未开放。</p><div class="admin-note"><Icon name="leaf" size={19} /><span>慢慢准备，等一个新的故事。</span></div><a href={base} class="button button-forest"><Icon name="right" size={18} class="flip-arrow" /> 回到首页</a></div></main>
</Layout>
